# Altaira Workspace frontend/local Next.js environment template
#
# Copy this file to `.env.local` for local development.
# `.env.local` is ignored by Git and may contain real local values.
# Do not commit `.env.local`.
#
# Security rule:
# - Values prefixed with NEXT_PUBLIC_ are visible to the browser.
# - Passwords and internal tokens must never use NEXT_PUBLIC_.

# Public browser URL for the local frontend.
# Source: local development URL or deployed frontend URL on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public browser-visible base URL for the backend.
# Local source: Spring Boot backend running on localhost.
# Deployed source: Render backend URL, for example https://<render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Admin login email used by the MVP admin login route.
# Source: choose a local admin email for development; set matching value in Vercel for deployment.
ADMIN_EMAIL=admin@altaira.local

# Admin login password for the MVP admin login route.
# Source: choose a local-only development password.
# Production/deployment source: Vercel environment variable.
# Never commit the real password.
ADMIN_PASSWORD=<local-admin-password>

# Internal server-to-server token used by Next.js API routes when calling protected backend endpoints.
# Source: must match backend INTERNAL_API_TOKEN in local backend and Render.
# Store the real shared token in `.env.local`, Render, and Vercel only.
INTERNAL_API_TOKEN=<same-token-as-backend>
