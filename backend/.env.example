# Backend environment template.
#
# Current recommended local backend database: Neon PostgreSQL.
# Spring Boot imports the real local secrets automatically from:
# /Volumes/T7/Altaira_Labs/.secrets/neon-render.env
#
# Keep real values out of Git. Do not commit backend/.env.

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-database-user>
SPRING_DATASOURCE_PASSWORD=<neon-database-password>
INTERNAL_API_TOKEN=<same-token-as-frontend>
ALTAIRA_AUTH_SESSION_HOURS=8
ALTAIRA_DEMO_ADMIN_ENABLED=true
ALTAIRA_DEMO_ADMIN_USERNAME=admin123
ALTAIRA_DEMO_ADMIN_PASSWORD=admin123
ALTAIRA_DEMO_ADMIN_ROLE=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Public lead email notifications.
# Put these in Render, not in Vercel. For Render Free, prefer Resend over HTTPS
# because outbound SMTP ports are blocked.
CONTACT_EMAIL_ENABLED=true
CONTACT_EMAIL_PROVIDER=resend
CONTACT_NOTIFICATION_TO=altairalabs@gmail.com
CONTACT_NOTIFICATION_FROM=onboarding@resend.dev
CONTACT_EMAIL_TIMEOUT_MS=30000
RESEND_API_KEY=<resend-api-key>
RESEND_API_URL=https://api.resend.com/emails

# SMTP fallback. Use only on local machines or paid hosting that allows outbound
# SMTP ports 25, 465 or 587. Use an app password/API password, never your normal
# mailbox password.
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password-or-app-password>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

# Optional local PostgreSQL override, only if you intentionally run Docker/local PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/altaira
# SPRING_DATASOURCE_USERNAME=<local-postgres-user>
# SPRING_DATASOURCE_PASSWORD=<local-postgres-password>
