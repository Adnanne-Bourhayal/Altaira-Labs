# Backend environment template.
#
# Current recommended local backend database: Neon PostgreSQL.
# Spring Boot imports the real local secrets automatically from:
# /Volumes/T7/Altaira_Labs/.secrets/neon-render.env
#
# Keep real values out of Git. Do not commit backend/.env.

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-database-user>
SPRING_DATASOURCE_PASSWORD=<neon-database-password>
INTERNAL_API_TOKEN=<same-token-as-frontend>
ALTAIRA_AUTH_SESSION_HOURS=8
# Disabled by default. Enable only for a controlled local/TFG demo and replace
# both example credentials with private values.
ALTAIRA_DEMO_ADMIN_ENABLED=false
ALTAIRA_DEMO_ADMIN_USERNAME=<private-demo-admin-username>
ALTAIRA_DEMO_ADMIN_PASSWORD=<private-strong-demo-admin-password>
ALTAIRA_DEMO_ADMIN_ROLE=admin

# Client Area Google login.
# GOOGLE_CLIENT_ID must be the same public web client id used by the frontend.
# The backend validates Google ID token audience and accepts only active invited
# client users with an active client_user_access relation.
GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
# Optional test/custom endpoint override. Leave unset for normal production.
GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo

# Client invitation and onboarding delivery.
# The production activation URL is required on Render so invitation emails do
# not point to localhost. The remaining values are optional explicit overrides.
ALTAIRA_CLIENT_INVITATION_ACTIVATE_URL=https://<frontend-domain>/client/activate
ALTAIRA_CLIENT_INVITATION_EXPIRES_DAYS=7
ONBOARDING_EMAIL_ENABLED=true
ONBOARDING_NOTIFICATION_FROM=onboarding@resend.dev
ONBOARDING_NOTIFICATION_ADMIN_TO=altairalabs@gmail.com
# Optional path to a service-specific PDF template. Leave unset for the generated fallback PDF.
# ONBOARDING_CONTRACT_PDF_PATH=/absolute/private/path/contract-template.pdf
# Local filesystem fallback only. Render files are ephemeral; use links/text for
# the TFG demo until durable S3 storage is fully integrated.
# ALTAIRA_ONBOARDING_STORAGE_DIR=/absolute/private/path/onboarding-files
ALTAIRA_ONBOARDING_MAX_FILE_SIZE_BYTES=15728640
ONBOARDING_MULTIPART_MAX_FILE_SIZE=20MB
ONBOARDING_MULTIPART_MAX_REQUEST_SIZE=50MB

# Client CRM public webhook intake.
# Optional non-secret URL shown in admin UI when generating API keys.
# The secret itself is generated per client and shown once in the admin panel.
CLIENT_CRM_WEBHOOK_PUBLIC_URL=https://<render-backend-domain>/api/v1/client-crm/webhooks/leads
# Client CRM urgent lead alerts.
# Uses Resend over HTTPS and sends to the client owner's email stored in `clients.email`.
# Only webhook-created leads with priority=urgent trigger this notification.
CLIENT_CRM_ALERTS_ENABLED=true
CLIENT_CRM_ALERTS_FROM=onboarding@resend.dev
CLIENT_CRM_DASHBOARD_URL=https://<frontend-domain>/client/dashboard
CLIENT_CRM_ALERTS_TIMEOUT_MS=6000

# Commercial approval -> Stripe Checkout -> activation flow.
# Backend/Render only. Never expose either Stripe secret to Next.js or commit them.
# Keep CHECKOUT_ENABLED=false and MODE=mock until Stripe test keys and the signed
# webhook endpoint are configured. Live keys are rejected by the application.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CHECKOUT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
STRIPE_MOCK_CONFIRMATION_ENABLED=false

# Commercial emails use the existing Resend HTTPS API. With no API key they are
# recorded as dry-run/skipped and do not block payment or client activation.
COMMERCIAL_EMAIL_ENABLED=false
COMMERCIAL_NOTIFICATION_FROM=onboarding@resend.dev
COMMERCIAL_EMAIL_TIMEOUT_MS=6000

# Emergency compatibility switch only. Leave false in production so a lead cannot
# bypass payment confirmation through the legacy direct-conversion endpoint.
ALTAIRA_LEGACY_DIRECT_CONVERSION_ENABLED=false

# Production/Render should not auto-migrate Neon on every boot.
# Use `update` only for controlled local development if you intentionally want
# Hibernate to add missing columns against a disposable/local database.
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Public lead email notifications.
# Put these in Render, not in Vercel. For Render Free, prefer Resend over HTTPS
# because outbound SMTP ports are blocked.
CONTACT_EMAIL_ENABLED=true
CONTACT_EMAIL_PROVIDER=resend
CONTACT_NOTIFICATION_TO=altairalabs@gmail.com
CONTACT_NOTIFICATION_FROM=onboarding@resend.dev
CONTACT_EMAIL_TIMEOUT_MS=30000
RESEND_API_KEY=<resend-api-key>
RESEND_API_URL=https://api.resend.com/emails
# Optional. Use {leadId} if you want the email button to open a specific lead.
CONTACT_ADMIN_DASHBOARD_URL=https://<frontend-domain>/leads/{leadId}
# Optional public HTTPS image URLs for the branded notification email.
CONTACT_BRAND_LOGO_URL=https://<frontend-domain>/brand/logo-white.png
CONTACT_BRAND_HEADER_IMAGE_URL=https://<frontend-domain>/brand/header_background.png

# SMTP fallback. Use only on local machines or paid hosting that allows outbound
# SMTP ports 25, 465 or 587. Use an app password/API password, never your normal
# mailbox password.
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password-or-app-password>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

# Optional local PostgreSQL override, only if you intentionally run Docker/local PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/altaira
# SPRING_DATASOURCE_USERNAME=<local-postgres-user>
# SPRING_DATASOURCE_PASSWORD=<local-postgres-password>

# Future AWS S3 direct-upload support for client portal files.
# Disabled by default. Keep secret keys only in Render/backend env, never in Git.
AWS_S3_ENABLED=false
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=eu-west-1
AWS_S3_PRIVATE_BUCKET=<private-client-files-bucket>
AWS_S3_PUBLIC_BUCKET=<optional-public-branding-bucket>
AWS_S3_PUBLIC_BASE_URL=https://<cdn-or-public-bucket-domain>
AWS_S3_PRESIGN_TTL_SECONDS=900

# GitHub App integration preparation.
# Keep disabled until the status endpoint and dry-run have been manually validated.
# The private key is base64-encoded and decoded only in backend memory.
GITHUB_APP_ENABLED=false
GITHUB_PROVISIONING_ENABLED=false
GITHUB_DRY_RUN=true
GITHUB_ORG=Altaira-Labs
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_ID=4339634
GITHUB_APP_CLIENT_ID=Iv23liG1o7dXGqZDEdd8
GITHUB_APP_INSTALLATION_ID=147629095
GITHUB_APP_PRIVATE_KEY_BASE64=<secret-base64-github-app-private-key>
GITHUB_APP_WEBHOOK_SECRET=
