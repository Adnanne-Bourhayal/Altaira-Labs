# Copy this file to a local backend env file or export these values in your shell.
# Do not commit real passwords, tokens, or production database URLs.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/<local-database-name>
SPRING_DATASOURCE_USERNAME=<local-database-user>
SPRING_DATASOURCE_PASSWORD=<local-database-password>
INTERNAL_API_TOKEN=<same-token-as-frontend>
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
